# "gemini" (default) | "ollama" | "groq" | "openai" | "cerebras"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq (alternative provider -- switch LLM_PROVIDER=groq to use it; the
# Gemini config above remains configured and available either way, and
# switching LLM_PROVIDER back to "gemini" is the only step needed to
# switch back).
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_API_KEY=not-needed
OPENAI_MODEL=gpt-4o
CEREBRAS_API_KEY=not-needed
CEREBRAS_MODEL=gpt-oss-120b
DATABASE_URL=postgresql://postgres:password@localhost:5432/acrla
CHROMA_PATH=./chroma_db
SECRET_KEY=acrla-secret-key
MOODLE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
MAX_RETRIEVAL_CHUNKS=5

# Conversation agent architecture: "simple" (default -- one planner call +
# one final-answer call, see agents/simple_agent.py) or "iterative" (the
# original agent_brain.decide() -> tool -> observe loop, kept as a fallback).
ACRLA_AGENT_MODE=simple

# Gate for large/bulk diagnostic log dumps (full canonical course records,
# manifests, analytics item arrays, tool arguments/results). Concise INFO
# logs (goal, selected pipeline, tools, call/token counts, fallback reason,
# provider error, latency) always print regardless. Default false.
ACRLA_DEBUG_VERBOSE=false

# Reserved, not yet wired to any behavior (default false) -- see config.py's
# comment on acrla_single_llm_call_mode for why the originally-requested
# keyword-based bypass was not implemented as-is.
ACRLA_SINGLE_LLM_CALL_MODE=false

# Quota-saving mode (default false): logs every skipped LLM call as
# "[ACRLA] quota_saver_skipped_llm reason=<reason>" and additionally skips
# the final-answer call for short, common greeting-style casual_conversation
# messages ("hi", "thanks", "bye", ...) -- see config.py's comment on
# acrla_quota_saver for the full list of effects.
ACRLA_QUOTA_SAVER=false
